# .gitignore · wastra-verificador
#
# El repositorio contiene una cadena probatoria: solo se versiona lo que un
# auditor debe poder leer. Todo artefacto generado por herramientas queda fuera.

# --- Artefactos de Python ---------------------------------------------------
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# --- Entornos virtuales -----------------------------------------------------
.venv/
venv/

# --- Directorio temporal del verificador ------------------------------------
# Donde el verificador descomprime el paquete bajo análisis. Nunca se versiona:
# su contenido procede de ficheros que no controlamos (ver §14 de la
# especificación, anti zip-slip y bomba de descompresión).
/tmp-verificacion/

# --- Registro de anclaje y evidencias (METADATOS SENSIBLES) -----------------
# El registro contiene NOMBRES y HUELLAS de documentos internos de gobernanza.
# wastra-verificador es Apache-2.0 y acabará publicado: versionarlo sería una
# fuga. Su lugar es la bóveda documental, FUERA del repo (ver herramientas/
# anclar.py y elevar.py, parámetro --registro). Estas reglas son la última red
# de seguridad por si alguna copia cae dentro del árbol del repositorio.
REGISTRO-ANCLAJE.jsonl
/evidencias-preelevacion/
exportacion-ejemplo.zip
